# ===== TikTok for Business (Ads API) =====
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_REDIRECT_URI=http://localhost:17890/callback
TIKTOK_ADVERTISER_ID=

# ===== 飞书自建应用 =====
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
FEISHU_ALLOWED_OPEN_IDS=ou_xxxx

# ===== 手机端 / Web 控制台 =====
# 服务监听端口，手机访问 http://<电脑IP>:<PORT>
PORT=5173

# 登录：账号密码 + 邮箱验证码（任意邮箱可登录，首次登录自动创建账号）
# 会话长期有效，只有点「退出登录」才会失效。
#
# 邮箱验证码需要发信渠道，留空则验证码登录不可用（密码登录不受影响）：
#   QQ 邮箱    SMTP_HOST=smtp.qq.com     SMTP_PORT=465  SMTP_PASS=邮箱设置里生成的"授权码"
#   163/126    SMTP_HOST=smtp.163.com    SMTP_PORT=465  同上用"授权码"，不是登录密码
#   Gmail      SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  需开启两步验证后生成"应用专用密码"
#   Outlook    SMTP_HOST=smtp.office365.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
